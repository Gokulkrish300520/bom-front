  "reorder_point": "20.00",
  "description": "An inventory item",
  "price": "10.00",
  "sku": "SKU_INV"
}

# Create item (all fields)
POST http://localhost:8000/api/items/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "name": "Full Item",
  "unit": "Kgs",
  "manage_sales_info": true,
  "sales_selling_price": "200.00",

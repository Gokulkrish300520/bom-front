### INVOICES CRUD

# List invoices
GET http://localhost:8000/api/invoices/
Authorization: Bearer <access_token>

####

# Create invoice with attached files (both attached_file_ids and invoice_file_ids)
POST http://localhost:8000/api/invoices/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "customer_id": 1,
  "invoice_number": "INV-2025-002",
  "order_number": "ORD-124",
  "invoice_date": "2025-09-04",
  "customer_notes": "Thank you for your business.",
  "terms_and_conditions": "Payment due in 30 days.",
  "total_amount": "15500.00",
  "attached_file_ids": [4, 5],
  "invoice_file_ids": [1, 2, 3]
}

####

# Retrieve invoice (with attached_files and invoice_files)
GET http://localhost:8000/api/invoices/1/
Authorization: Bearer <access_token>

# Response example:
# {
#   "id": 1,
#   ...
#   "item_details": [
#     {"id": 1, "item": { ... }, "quantity": 2, "rate": "5000.00", "amount": "10000.00", "invoice_item_number": 1},
#     {"id": 2, "item": { ... }, "quantity": 1, "rate": "1000.00", "amount": "1000.00", "invoice_item_number": 2}
#   ],
#   "attached_files": [
#     {"id": 4, "file": "/media/customer_documents/file4.pdf", "uploaded_at": "..."},
#     {"id": 5, "file": "/media/customer_documents/file5.pdf", "uploaded_at": "..."}
#   ],
#   "invoice_files": [
#     {"id": 1, "file": "/media/customer_documents/file1.pdf", "uploaded_at": "..."},
#     {"id": 2, "file": "/media/customer_documents/file2.pdf", "uploaded_at": "..."},
#     {"id": 3, "file": "/media/customer_documents/file3.pdf", "uploaded_at": "..."}
#   ],
#   ...
# }

####
# Update invoice (partial or full, can update attached_file_ids and invoice_file_ids)
PUT http://localhost:8000/api/invoices/1/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "customer_notes": "Updated notes",
  "total_amount": "16000.00",
  "attached_file_ids": [6],
  "invoice_file_ids": [2, 3]
}

####
# Delete invoice
DELETE http://localhost:8000/api/invoices/1/
Authorization: Bearer <access_token>

### ITEMS CRUD

# List items
GET http://localhost:8000/api/items/
Authorization: Bearer <access_token>

####

# Create item (basic)
POST http://localhost:8000/api/items/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "name": "Item 1",
  "unit": "Nos",
  "description": "A sample item",
  "price": "10.00",
  "sku": "SKU001"
}

# Create item (with sales info)
POST http://localhost:8000/api/items/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "name": "Sales Item",
  "unit": "Kgs",
  "manage_sales_info": true,
  "sales_selling_price": "100.00",
  "sales_account": "Sales",
  "sales_description": "Sales item description",
  "description": "A sales item",
  "price": "100.00",
  "sku": "SKU_SALES"
}


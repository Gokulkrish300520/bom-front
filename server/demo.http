  "sales_description": "Full item sales",
  "manage_purchase_info": true,
  "purchase_cost_price": "150.00",
  "purchase_account": "Cost of Goods Sold",
  "purchase_description": "Full item purchase",
  "preferred_vendor": 1,
  "track_inventory": true,
  "inventory_account": "Inventory",
  "inventory_valuation_method": "FIFO",

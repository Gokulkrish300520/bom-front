Content-Type: application/json

{
  "customer_id": 1,
  "quote_number": "Q-2025-001",
  "reference_number": "REF-123",
  "quote_date": "2025-08-27",
  "expiry_date": "2025-09-10",
  "salesperson": "Alice Smith",
  "project_name": "Project X",
  "subject": "Quotation for Project X",
  "customer_notes": "Please review and confirm.",
  "terms_and_conditions": "Payment within 30 days.",
  "subtotal": "10000.00",
  "discount": "5.00",
  "tax_type": "TDS",
  "tax_percentage": "5",
  "adjustment": "-100.00",
  "total_amount": "9500.00",
  "item_details": [
    {"quote_item_number": 1, "item_id": 1, "quantity": 2, "rate": "5000.00", "amount": "10000.00"},
    {"quote_item_number": 2, "item_id": 2, "quantity": 1, "rate": "1000.00", "amount": "1000.00"}
  ]
}


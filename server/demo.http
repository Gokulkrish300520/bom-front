  "unit": "Litres",
  "manage_purchase_info": true,
  "purchase_cost_price": "80.00",
  "purchase_account": "Cost of Goods Sold",
  "purchase_description": "Purchase item description",
  "preferred_vendor": 1,
  "description": "A purchase item",
  "price": "80.00",
  "sku": "SKU_PURCHASE"
}


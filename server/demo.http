### INVENTORY MANAGEMENT CRUD

# List inventory management records
GET http://localhost:8000/api/inventory-management/
Authorization: Bearer <access_token>

####
# Create inventory management record
POST http://localhost:8000/api/inventory-management/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "item_name": "Test Item",
  "unit": "Nos",
  "type": "Goods",
  "hsn_code": "1234",
  "description": "Test description",
  "selling_price": "100.00",
  "purchase_price": "80.00",
  "tax": "18%",
  "item_details": [
    {"description": "Batch 1", "quantity": "10.00", "adjustment": "0.00", "amount": "1000.00"},
    {"description": "Batch 2", "quantity": "5.00", "adjustment": "1.00", "amount": "500.00"}
  ]
}

####
# Retrieve inventory management record
GET http://localhost:8000/api/inventory-management/1/
Authorization: Bearer <access_token>

####
# Update inventory management record
PUT http://localhost:8000/api/inventory-management/1/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "item_name": "Updated Name",
  "unit": "Nos",
  "type": "Goods",
  "hsn_code": "9999",
  "description": "desc",
  "selling_price": "300.00",
  "purchase_price": "250.00",
  "tax": "5%",
  "item_details": []
}

####
# Delete inventory management record
DELETE http://localhost:8000/api/inventory-management/1/
Authorization: Bearer <access_token>
### AUTHENTICATION

# Obtain JWT token
POST http://localhost:8000/api/auth/token/
Content-Type: application/json

{
    "username":"Gokul",
    "password":"Gokul@2005"
}

####
# Refresh JWT token
POST http://localhost:8000/api/auth/token/refresh/
Content-Type: application/json

{
    "refresh": "<refresh_token>"
}

### Refresh Access Token (access: 10 min, refresh: 15 min)
POST http://localhost:8000/api/auth/token/refresh/
Content-Type: application/json

{
  "refresh": "<refresh_token>"
}

### Logout (Blacklist Refresh Token)
POST http://localhost:8000/api/auth/logout/
Content-Type: application/json

{
  "refresh": "<refresh_token>"
}

// After logout, the refresh token is blacklisted and cannot be used again. The access token remains valid until it expires (10 minutes).



### FILES (UPLOADED DOCUMENTS) ENDPOINT


# Upload a PDF file
POST http://localhost:8000/api/files/
Authorization: Bearer <access_token>
Content-Type: multipart/form-data

file: @./sample_invoice.pdf

####

# Upload a JPG file
POST http://localhost:8000/api/files/
Authorization: Bearer <access_token>
Content-Type: multipart/form-data

file: @./sample_receipt.jpg

####

# Update/replace a file (PDF)
PUT http://localhost:8000/api/files/1/
Authorization: Bearer <access_token>
Content-Type: multipart/form-data

file: @./updated_invoice.pdf

####

# Update/replace a file (JPG)
PUT http://localhost:8000/api/files/2/
Authorization: Bearer <access_token>
Content-Type: multipart/form-data

file: @./updated_receipt.jpg

####
# List all files
GET http://localhost:8000/api/files/
Authorization: Bearer <access_token>

####

# Get file metadata only
GET http://localhost:8000/api/files/1/?meta=1
Authorization: Bearer <access_token>

# Response:
# {
#   "id": 1,
#   "file": "/media/customer_documents/invoice.pdf",
#   "uploaded_at": "2025-08-30T12:00:00Z"
# }

####

# View/Download a file (PDF or JPG, stream content)
GET http://localhost:8000/api/files/1/
Authorization: Bearer <access_token>

# Response: (file stream, e.g. PDF, JPG, etc)
# If the file exists, the file will be returned as a download or inline view.
# If the file does not exist, HTTP 404 will be returned.

####
# Delete a file
DELETE http://localhost:8000/api/files/1/
Authorization: Bearer <access_token>


### CUSTOMERS CRUD

# List customers
GET http://localhost:8000/api/customers/
Authorization: Bearer <access_token>

####
# Create customer (all fields)
POST http://localhost:8000/api/customers/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "customer_type": "business",
  "salutation": "mr",
  "first_name": "John",
  "last_name": "Doe",
  "company_name": "Acme Corp",
  "display_name": "Acme Corp (John Doe)",
  "email": "john.doe@acme.com",
  "work_phone": "1234567890",
  "mobile": "9876543210",
  "pan": "ABCDE1234F",
  "currency": "INR",
  "opening_balance": "1000.00",
  "payment_terms": "net_30",
  "billing_attention": "Accounts",
  "billing_country": "India",
  "billing_street1": "123 Main St",
  "billing_street2": "Suite 100",
  "billing_city": "Mumbai",
  "billing_state": "MH",
  "billing_pin_code": "400001",
  "billing_phone": "0221234567",
  "billing_fax": "0227654321",
  "shipping_attention": "Warehouse",
  "shipping_country": "India",
  "shipping_street1": "456 Warehouse Rd",
  "shipping_street2": "",
  "shipping_city": "Mumbai",
  "shipping_state": "MH",
  "shipping_pin_code": "400002",
  "shipping_phone": "0229876543",
  "shipping_fax": "0223456789",
  "contact_persons": [
    {
      "salutation": "ms",
      "first_name": "Jane",
      "last_name": "Smith",
      "email": "jane@acme.com",
      "work_phone": "",
      "mobile": ""
    }
  ],
  "custom_fields": {"GSTIN": "27ABCDE1234F1Z5"},
  "tags": ["priority", "2025"],
  "remarks": "Important customer"
}

####
# Retrieve customer (with nested documents and contact persons)
GET http://localhost:8000/api/customers/1/
Authorization: Bearer <access_token>

####

# Update customer (update, add, and remove contact persons)
PUT http://localhost:8000/api/customers/1/
Authorization: Bearer <access_token>
Content-Type: application/json

{
  "display_name": "Acme Corp (Updated)",
  "email": "john.doe@acme.com",
  "customer_type": "business",
  "company_name": "Acme Corp",
  "currency": "INR",
  "payment_terms": "net_30",
  "contact_persons": [
    {"id": 1, "salutation": "ms", "first_name": "Jane", "last_name": "Smith", "email": "jane@acme.com", "work_phone": "", "mobile": ""},
    {"first_name": "New", "last_name": "Person", "email": "new@acme.com", "work_phone": "", "mobile": "", "salutation": null}
  ]
}

# Response:
# {
#   ...
#   "contact_persons": [
#     {"id": 1, "salutation": "ms", "first_name": "Jane", "last_name": "Smith", "email": "jane@acme.com", "work_phone": "", "mobile": ""},
#     {"id": 2, "salutation": null, "first_name": "New", "last_name": "Person", "email": "new@acme.com", "work_phone": "", "mobile": ""}
#   ]
#   ...
# }

# - Contact person with id 1 is updated in place.
# - New contact person is created for "New Person".
# - Any other contact persons previously associated with the customer are deleted.

####
# Delete customer
DELETE http://localhost:8000/api/customers/1/
Authorization: Bearer <access_token>

